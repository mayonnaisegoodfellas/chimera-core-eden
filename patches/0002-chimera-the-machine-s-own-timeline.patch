new file mode 100644
--- /dev/null
+++ b/src/audio_core/sink/chimera_sink.h
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Chimera: the machine's sound, taken by the frontend a frame at a time.
+// Where a host sink has a device's callback asking for samples at the host's
+// pace, this one has a CoreTiming event every 5 ms of machine time that pulls
+// 240 frames from every stream and mixes them. Everything upstream of it
+// (the renderer's streams, audio out's buffers and their release events) is
+// then paced by the machine's own clock.
+
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "audio_core/sink/sink.h"
+#include "audio_core/sink/sink_stream.h"
+#include "core/core.h"
+#include "core/core_timing.h"
+
+namespace AudioCore::Sink {
+
+class ChimeraSinkStream final : public SinkStream {
+public:
+    explicit ChimeraSinkStream(Core::System& system_, StreamType type_, u32 system_channels_,
+                               const std::string& name_)
+        : SinkStream{system_, type_} {
+        system_channels = system_channels_;
+        device_channels = 2;
+        name = name_;
+    }
+    ~ChimeraSinkStream() override = default;
+
+    void Start(bool = false) override {
+        paused = false;
+    }
+    void Stop() override {
+        paused = true;
+        SignalPause();
+    }
+    StreamType Type() const {
+        return type;
+    }
+};
+
+class ChimeraSink final : public Sink {
+public:
+    // frames pulled at each event: 5 ms at 48 kHz
+    static constexpr size_t PullFrames = 240;
+
+    explicit ChimeraSink(std::string_view) {
+        device_channels = 2;
+    }
+    ~ChimeraSink() override {
+        if (system && pull_event) {
+            system->CoreTiming().UnscheduleEvent(pull_event);
+        }
+    }
+
+    SinkStream* AcquireSinkStream(Core::System& system_, u32 system_channels_,
+                                  const std::string& name, StreamType type) override {
+        system_channels = system_channels_;
+        auto& stream = streams.emplace_back(
+            std::make_unique<ChimeraSinkStream>(system_, type, system_channels_, name));
+        stream->SetDeviceVolume(device_volume);
+        if (!pull_event) {
+            system = &system_;
+            pull_event = Core::Timing::CreateEvent(
+                "ChimeraAudioPull",
+                [this](s64, std::chrono::nanoseconds) -> std::optional<std::chrono::nanoseconds> {
+                    Pull();
+                    return std::nullopt;
+                });
+            system->CoreTiming().ScheduleLoopingEvent(std::chrono::milliseconds(5),
+                                                      std::chrono::milliseconds(5), pull_event);
+        }
+        return stream.get();
+    }
+
+    void CloseStream(SinkStream* stream) override {
+        std::erase_if(streams, [stream](const auto& s) { return s.get() == stream; });
+    }
+    void CloseStreams() override {
+        streams.clear();
+    }
+    f32 GetDeviceVolume() const override {
+        return device_volume;
+    }
+    void SetDeviceVolume(f32 volume) override {
+        device_volume = volume;
+        for (auto& stream : streams) {
+            stream->SetDeviceVolume(volume);
+        }
+    }
+    void SetSystemVolume(f32 volume) override {
+        for (auto& stream : streams) {
+            stream->SetSystemVolume(volume);
+        }
+    }
+
+    /// Stereo pairs mixed since the last call (interleaved), and forgets them.
+    std::vector<s16> Take() {
+        std::vector<s16> out;
+        out.swap(output);
+        return out;
+    }
+
+private:
+    void Pull() {
+        mix.assign(PullFrames * 2, 0);
+        scratch.resize(PullFrames * 2);
+        for (auto& stream : streams) {
+            if (stream->IsPaused()) {
+                continue;
+            }
+            if (stream->Type() == StreamType::In) {
+                // no microphone: the machine records silence
+                std::fill(scratch.begin(), scratch.end(), s16{0});
+                stream->ProcessAudioIn(scratch, PullFrames);
+                continue;
+            }
+            stream->ProcessAudioOutAndRender(scratch, PullFrames);
+            for (size_t i = 0; i < mix.size(); i++) {
+                mix[i] += scratch[i];
+            }
+        }
+        const size_t at = output.size();
+        output.resize(at + mix.size());
+        for (size_t i = 0; i < mix.size(); i++) {
+            output[at + i] = static_cast<s16>(std::clamp<s32>(mix[i], -32768, 32767));
+        }
+        // nobody took it for a second (the frontend is not listening): keep
+        // the last second only
+        constexpr size_t Cap = 48000 * 2;
+        if (output.size() > Cap * 2) {
+            output.erase(output.begin(), output.end() - Cap);
+        }
+    }
+
+    Core::System* system{};
+    std::shared_ptr<Core::Timing::EventType> pull_event;
+    std::vector<std::unique_ptr<ChimeraSinkStream>> streams;
+    std::vector<s32> mix;
+    std::vector<s16> scratch;
+    std::vector<s16> output;
+};
+
+} // namespace AudioCore::Sink
