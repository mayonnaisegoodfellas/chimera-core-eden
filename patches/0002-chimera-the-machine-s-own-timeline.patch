 namespace Common::Random {
+#ifdef CHIMERA
+    // Chimera: the machine's randomness is its own, the same in every run -
+    // one generator with a fixed seed, asked in the machine's own order
+    // (everything that asks runs on the machine's timeline). The host's
+    // random device would give every run another address space layout.
+    struct MachineRandom {
+        std::mt19937 gen{0x43484d52u};
+        u32 operator()() noexcept {
+            return static_cast<u32>(gen());
+        }
+    };
+    [[nodiscard]] static MachineRandom& GetGlobalRandomDevice() noexcept {
+        static MachineRandom g_random{};
+        return g_random;
+    }
+#else
     [[nodiscard]] static std::random_device& GetGlobalRandomDevice() noexcept {
         static std::random_device g_random_device{};
         return g_random_device;
     }
+#endif
     [[nodiscard]] u32 Random32(u32 seed) noexcept {
         return GetGlobalRandomDevice()();
     }
