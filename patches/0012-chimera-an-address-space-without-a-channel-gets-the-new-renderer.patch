+namespace {
+// every address space alive, so a renderer made again reaches each one: a
+// channel rebinds its own, but a game can map memory into an address space
+// before any channel uses it, which then kept the renderer that was freed
+std::mutex chimera_all_mutex;
+std::vector<MemoryManager*> chimera_all;
+} // namespace
+
+void MemoryManager::ChimeraRebindAll(VideoCore::RasterizerInterface* rasterizer_) {
+    std::scoped_lock lock{chimera_all_mutex};
+    for (MemoryManager* const manager : chimera_all) {
+        if (manager->rasterizer != nullptr) {
+            manager->BindRasterizer(rasterizer_);
+        }
+    }
+}
+#endif
