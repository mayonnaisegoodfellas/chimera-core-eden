+#ifdef CHIMERA
+    // the consumer that frees a slot is the compositor, at vsync, on the
+    // same host thread: wait on the machine's clock
+    while (!dequeue_possible.load()) {
+        lk.unlock();
+        Core::ChimeraGuestSleep(100'000);
+        lk.lock();
+    }
+    dequeue_possible.store(false);
+    return true;
