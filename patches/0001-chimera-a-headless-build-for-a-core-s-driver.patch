diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -71,6 +71,14 @@
 endif()
 
 # qt stuff
+# Chimera: the emulator's libraries under a core's own driver - no frontend,
+# no window, no SDL, no host audio or input (see CHIMERA_DRIVER_DIR in src/)
+option(CHIMERA_HEADLESS "Build the libraries for a Chimera core's driver" OFF)
+set(CHIMERA_DRIVER_DIR "" CACHE PATH "The driver's CMake directory (CHIMERA_HEADLESS)")
+if (CHIMERA_HEADLESS)
+    add_compile_definitions(CHIMERA=1)
+endif()
+
 option(ENABLE_QT "Enable the Qt frontend" ON)
 option(ENABLE_QT_TRANSLATION "Enable translations for the Qt frontend" OFF)
 option(ENABLE_UPDATE_CHECKER "Enable update checker (for Qt and Android)" OFF)
@@ -565,7 +573,7 @@
         find_package(oaknut)
     endif()
 
-    if (NOT ANDROID)
+    if (NOT ANDROID AND NOT CHIMERA_HEADLESS)
         find_package(SDL3)
     endif()
 
diff --git a/externals/CMakeLists.txt b/externals/CMakeLists.txt
--- a/externals/CMakeLists.txt
+++ b/externals/CMakeLists.txt
@@ -141,7 +141,9 @@
     endif()
 endif()
 
-if (NOT YUZU_USE_BUNDLED_SDL3)
+if (CHIMERA_HEADLESS)
+    # no SDL: a Chimera core has no window, no host audio and no host input
+elseif (NOT YUZU_USE_BUNDLED_SDL3)
     if (NOT WIN32)
         # Yuzu itself needs: Atomic Audio Events Joystick Haptic Sensor Threads Timers
         # Since 2.0.18 Atomic+Threads required for HIDAPI/libusb (see https://github.com/libsdl-org/SDL/issues/5095)
@@ -175,7 +177,7 @@
 
 # Normalize SDL3 link target across package variants.
 # Some SDL3 packages export only SDL3::SDL3-shared or SDL3::SDL3-static.
-if (NOT TARGET SDL3::SDL3)
+if (NOT TARGET SDL3::SDL3 AND NOT CHIMERA_HEADLESS)
     if (TARGET SDL3::SDL3-shared)
         add_library(SDL3::SDL3 ALIAS SDL3::SDL3-shared)
     elseif (TARGET SDL3::SDL3-static)
