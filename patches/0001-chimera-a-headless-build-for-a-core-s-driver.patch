diff --git a/src/common/fs/path_util.cpp b/src/common/fs/path_util.cpp
--- a/src/common/fs/path_util.cpp
+++ b/src/common/fs/path_util.cpp
@@ -111,7 +111,7 @@
     void Reinitialize(fs::path eden_path = {}) {
         fs::path eden_path_cache;
         fs::path eden_path_config;
-#ifdef _WIN32
+#if defined(_WIN32) && !defined(CHIMERA)
         // User directory takes priority over global %AppData% directory
         eden_path = GetExeDirectory() / PORTABLE_DIR;
         if (!Exists(eden_path) || !IsDir(eden_path)) {
@@ -127,6 +127,15 @@
         LEGACY_PATH(Yuzu, YUZU)
         LEGACY_PATH(Suyu, SUYU)
 #undef LEGACY_PATH
+#elif defined(CHIMERA)
+        // Chimera: the machine's own directory, given by the driver
+        // (SetAppDirectory), and nothing of the host's - no XDG directory,
+        // no other emulator's. Until the driver names it there is none.
+        if (eden_path.empty()) {
+            return;
+        }
+        eden_path_cache = eden_path / CACHE_DIR;
+        eden_path_config = eden_path / CONFIG_DIR;
 #elif __ANDROID__
         ASSERT(!eden_path.empty());
         eden_path_cache = eden_path / CACHE_DIR;
