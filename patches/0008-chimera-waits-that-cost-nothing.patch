 void CoreTiming::Idle() {
+#ifdef CHIMERA
+    // Chimera: this is asked when every core has been found idle
+    // (CpuManager::PreemptSingleCore), and then nothing can happen before
+    // the next event: the clock goes straight there. Upstream creeps towards
+    // it a thousand cycles - a microsecond of the machine's time - at a time,
+    // with a round of the scheduler and its fibers for each; a game asleep
+    // until the next vsync cost thousands of rounds a frame, 43% of the
+    // host's time on a game measured.
+    if (!is_multicore) {
+        std::scoped_lock lock{basic_lock};
+        if (!event_queue.empty()) {
+            using Ratio = Common::WallClock::CPUTickToNsRatio;
+            const u64 next_ns = static_cast<u64>((std::max<s64>)(event_queue.top().time, 0));
+            // the first tick count whose time is the event's or later
+            const u64 target = (next_ns * Ratio::den + Ratio::num - 1) / Ratio::num;
+            if (target > cpu_ticks) {
+                downcount -= static_cast<s64>(target - cpu_ticks);
+                cpu_ticks = target;
+            }
+            return;
+        }
+    }
+#endif
     AddTicks(1000U);
 }
 
