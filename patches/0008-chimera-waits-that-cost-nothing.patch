 /// Chimera: the machine's clock, for code that has no System at hand and
 /// would otherwise read the host's.
 s64 ChimeraTimeNs();
+/// Chimera: what a guest thread waits for inside the emulator's own code,
+/// in place of a host condition variable. Wait puts the calling guest
+/// thread to sleep in the machine's kernel until `ready` holds; Signal
+/// wakes the sleepers to look again. (Sleeping on the clock and looking
+/// every tenth of a millisecond did the same at ten thousand wake-ups a
+/// second of machine time, each a timer event and two thread switches.)
+class ChimeraGuestCondition {
+public:
+    ChimeraGuestCondition();
+    ~ChimeraGuestCondition();
+    void Wait(const std::function<bool()>& ready);
+    void Signal();
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl;
+};
 #endif
 
 class System {
