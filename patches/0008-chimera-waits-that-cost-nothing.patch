+struct ChimeraGuestCondition::Impl {
+    explicit Impl(Kernel::KernelCore& kernel) : lock{kernel}, condition{kernel} {}
+    Kernel::KLightLock lock;
+    Kernel::KLightConditionVariable condition;
+};
+
+ChimeraGuestCondition::ChimeraGuestCondition() = default;
+ChimeraGuestCondition::~ChimeraGuestCondition() = default;
+
+void ChimeraGuestCondition::Wait(const std::function<bool()>& ready) {
+    if (!impl) {
+        // (made at the first wait: the kernel is there by then)
+        impl = std::make_unique<Impl>(g_chimera_system->Kernel());
+    }
+    Kernel::KScopedLightLock lk{impl->lock};
+    while (!ready()) {
+        // (a thread being ended is not put to sleep, and must not spin here)
+        if (Kernel::GetCurrentThread(g_chimera_system->Kernel()).IsTerminationRequested()) {
+            break;
+        }
+        impl->condition.Wait(std::addressof(impl->lock));
+    }
+}
+
+void ChimeraGuestCondition::Signal() {
+    if (impl) {
+        impl->condition.Broadcast();
+    }
+}
+
 s64 ChimeraTimeNs() {
     return g_chimera_system ? g_chimera_system->CoreTiming().GetGlobalTimeNs().count() : 0;
 }
