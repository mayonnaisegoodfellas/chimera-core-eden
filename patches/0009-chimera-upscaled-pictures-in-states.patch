+#ifdef CHIMERA
+template <class P>
+size_t TextureCache<P>::ChimeraBindId(size_t index) const {
+    for (const auto& [bind_id, at] : channel_map) {
+        if (at == index) {
+            return static_cast<size_t>(bind_id);
+        }
+    }
+    return UNSET_CHANNEL;
+}
+
+template <class P>
+u64 TextureCache<P>::ChimeraGuestHash(const ImageBase& image) {
+    auto& h = ChimeraKept::hooks;
+    // an image at no address of the console's (a fake one past its memory)
+    // has no bytes there
+    constexpr u64 end = 1ULL << Tegra::MaxwellDeviceMemoryManager::AS_BITS;
+    if (image.cpu_addr == 0 || image.cpu_addr >= end || image.guest_size_bytes > end - image.cpu_addr ||
+        h.scratch == nullptr || h.scratch_bytes < 8) {
+        return 0;
+    }
+    const size_t piece = h.scratch_bytes & ~size_t{7};
+    u64 hash = 0;
+    for (u64 at = 0; at < image.guest_size_bytes; at += piece) {
+        const size_t n = (std::min<u64>)(piece, image.guest_size_bytes - at);
+        device_memory.ReadBlockUnsafe(image.cpu_addr + at, h.scratch, n);
+        hash = ChimeraKept::Digest(hash, h.scratch, n);
+    }
+    return hash;
+}
+
+template <class P>
+void TextureCache<P>::ChimeraKeep() {
+    auto& h = ChimeraKept::hooks;
+    if (!h.keep || !h.found || !Settings::values.resolution_info.active) {
+        return;
+    }
+    // in the order the cache holds them, which is the order they are made
+    // again in after a load
+    size_t count = 0, left_out = 0;
+    for (auto [id, image] : slot_images) {
+        if (False(image->flags & ImageFlagBits::Registered)) {
+            continue;
+        }
+        const bool rescaled = True(image->flags & ImageFlagBits::Rescaled);
+        if (!rescaled && image->scale_rating == 0) {
+            continue;
+        }
+        if (count == h.most) {
+            left_out++;
+            continue;
+        }
+        ChimeraKept::Found& f = h.found[count++];
+        f = {};
+        ChimeraKept::Record& r = f.record;
+        r.info = image->info;
+        r.gpu_addr = image->gpu_addr;
+        r.cpu_addr = image->cpu_addr;
+        r.channel = image->channel;
+        r.guest_hash = ChimeraGuestHash(*image);
+        r.modification_tick = image->modification_tick;
+        r.scaled_writes = image->chimera_scaled_writes;
+        r.scale_tick = image->scale_tick;
+        r.scale_rating = image->scale_rating;
+        r.rescaled = rescaled ? 1 : 0;
+        r.gpu_modified = True(image->flags & ImageFlagBits::GpuModified) ? 1 : 0;
+        r.had_views = image->image_view_ids.empty() ? 0 : 1;
+        if constexpr (requires(Image& i) { i.ChimeraBytesPerPixel(); }) {
+            const u32 bpp = rescaled ? image->ChimeraBytesPerPixel() : 0;
+            if (bpp != 0) {
+                u64 bytes = 0;
+                for (s32 level = 0; level < image->info.resources.levels; level++) {
+                    bytes += u64{image->ChimeraScaledWidth(static_cast<u32>(level))} *
+                             image->ChimeraScaledHeight(static_cast<u32>(level)) * bpp *
+                             static_cast<u32>(image->info.resources.layers);
+                }
+                f.bytes = bytes;
+                f.bytes_per_pixel = bpp;
+                f.image = image;
+                f.read = [](void* self, u32 level, u32 layer, u32 y, u32 rows, u8* out, size_t out_bytes) {
+                    static_cast<Image*>(self)->ChimeraReadScaled(level, layer, y, rows, out, out_bytes);
+                };
+                f.width = [](void* self, u32 level) {
+                    return static_cast<Image*>(self)->ChimeraScaledWidth(level);
+                };
+                f.height = [](void* self, u32 level) {
+                    return static_cast<Image*>(self)->ChimeraScaledHeight(level);
+                };
+            }
+        }
+    }
+    h.keep(h.found, count, left_out, frame_tick, modification_tick);
+}
+
+template <class P>
+void TextureCache<P>::ChimeraRestore() {
+    auto& h = ChimeraKept::hooks;
+    size_t count = 0;
+    u64 kept_frame_tick = 0, kept_modification_tick = 0;
+    if (!h.kept || !h.record || !Settings::values.resolution_info.active ||
+        !h.kept(&count, &kept_frame_tick, &kept_modification_tick)) {
+        return;
+    }
+    // This cache stands where the one the state was taken from stood: its
+    // counters go on from there, and its images are made again in the order
+    // that one held them, each as it was.
+    frame_tick = kept_frame_tick;
+    modification_tick = kept_modification_tick;
+    const size_t channel_before = ChimeraBindId(current_channel_id);
+    for (size_t i = 0; i < count; i++) {
+        const u8* pixels = nullptr;
+        u64 bytes = 0;
+        const ChimeraKept::Record& r = *h.record(i, &pixels, &bytes);
+        if (r.channel == UNSET_CHANNEL || !channel_map.contains(static_cast<s32>(r.channel))) {
+            continue;
+        }
+        if (ChimeraBindId(current_channel_id) != r.channel) {
+            BindToChannel(static_cast<s32>(r.channel));
+        }
+        const ImageId image_id = InsertImage(r.info, r.gpu_addr, RelaxedOptions{});
+        Image& image = slot_images[image_id];
+        // (joined into a larger image, or the console's memory is no longer
+        // what it was: the cache makes it from that memory, as at 1x)
+        if (image.gpu_addr != r.gpu_addr || image.cpu_addr != r.cpu_addr ||
+            image.info.format != r.info.format || image.info.size != r.info.size ||
+            ChimeraGuestHash(image) != r.guest_hash) {
+            continue;
+        }
+        image.scale_rating = r.scale_rating;
+        image.scale_tick = r.scale_tick;
+        if (r.rescaled && ImageCanRescale(image)) {
+            RefreshContents(image, image_id);
+            ScaleUp(image);
+            if constexpr (requires(Image& i) { i.ChimeraWriteScaled(pixels); }) {
+                if (pixels != nullptr && bytes != 0 && True(image.flags & ImageFlagBits::Rescaled)) {
+                    image.ChimeraWriteScaled(pixels);
+                }
+            }
+        }
+        image.modification_tick = r.modification_tick;
+        image.chimera_scaled_writes = r.scaled_writes;
+        if (r.gpu_modified) {
+            image.flags |= ImageFlagBits::GpuModified;
+        }
+        // the screen is shown from an image only once it has a view: one that
+        // had views gets its plain one, as the screen's lookup would make it
+        if (r.had_views && image.image_view_ids.empty()) {
+            (void)FindOrEmplaceImageView(image_id, ImageViewInfo{ImageViewType::e2D, image.info.format});
+        }
+    }
+    if (channel_before != UNSET_CHANNEL && ChimeraBindId(current_channel_id) != channel_before) {
+        BindToChannel(static_cast<s32>(channel_before));
+    }
+}
+#endif
