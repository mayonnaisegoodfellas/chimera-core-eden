+}
+
+void Image::ChimeraWriteScaled(const u8* pixels) {
+    ChimeraPixelStore store{false};
+    const u32 bpp = ChimeraBytesPerPixel();
+    for (s32 level = 0; level < info.resources.levels; level++) {
+        const u32 w = ChimeraScaledWidth(static_cast<u32>(level));
+        const u32 h = ChimeraScaledHeight(static_cast<u32>(level));
+        for (s32 layer = 0; layer < info.resources.layers; layer++) {
+            glTextureSubImage3D(upscaled_backup.handle, level, 0, 0, layer, static_cast<GLsizei>(w),
+                                static_cast<GLsizei>(h), 1, gl_format, gl_type, pixels);
+            pixels += static_cast<size_t>(w) * h * bpp;
+        }
+    }
+}
