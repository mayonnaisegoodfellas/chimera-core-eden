+// The pixel transfer state a client-memory read or write needs (no buffer
+// bound, rows tightly packed), and the renderer's own put back after it.
+struct ChimeraPixelStore {
+    explicit ChimeraPixelStore(bool pack_) : pack{pack_} {
+        glGetIntegerv(pack ? GL_PIXEL_PACK_BUFFER_BINDING : GL_PIXEL_UNPACK_BUFFER_BINDING, &buffer);
+        for (size_t i = 0; i < names.size(); i++) {
+            glGetIntegerv(Name(i), &values[i]);
+        }
+        glBindBuffer(pack ? GL_PIXEL_PACK_BUFFER : GL_PIXEL_UNPACK_BUFFER, 0);
+        for (size_t i = 0; i < names.size(); i++) {
+            glPixelStorei(Name(i), i == 0 ? 1 : 0);
+        }
+    }
+    ~ChimeraPixelStore() {
+        for (size_t i = 0; i < names.size(); i++) {
+            glPixelStorei(Name(i), values[i]);
+        }
+        glBindBuffer(pack ? GL_PIXEL_PACK_BUFFER : GL_PIXEL_UNPACK_BUFFER, static_cast<GLuint>(buffer));
+    }
+    GLenum Name(size_t i) const {
+        return pack ? pack_names[i] : names[i];
+    }
+    static constexpr std::array<GLenum, 6> names{GL_UNPACK_ALIGNMENT,   GL_UNPACK_ROW_LENGTH,
+                                                 GL_UNPACK_IMAGE_HEIGHT, GL_UNPACK_SKIP_ROWS,
+                                                 GL_UNPACK_SKIP_PIXELS,  GL_UNPACK_SKIP_IMAGES};
+    static constexpr std::array<GLenum, 6> pack_names{GL_PACK_ALIGNMENT,   GL_PACK_ROW_LENGTH,
+                                                      GL_PACK_IMAGE_HEIGHT, GL_PACK_SKIP_ROWS,
+                                                      GL_PACK_SKIP_PIXELS,  GL_PACK_SKIP_IMAGES};
+    bool pack;
+    GLint buffer = 0;
+    std::array<GLint, 6> values{};
+};
+} // namespace
