@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Chimera: the pictures the renderer draws above the console's resolution,
+// kept where a savestate holds them.
+//
+// Above 1x an image the GPU draws into is a texture of the larger size on the
+// host's card, and the console's memory only gets it scaled down. A renderer
+// made again after a load (a new GL context) would make its images again from
+// that memory as the game uses them: other pixels than the ones it had, not
+// upscaled yet (the cache upscales a render target after it has been one for
+// two frames), and absent when the screen is shown before the game draws
+// again (the picture then comes from the console's memory at 1x). Before a
+// state is taken the core asks the cache for every image whose scaling a load
+// would lose (`Keep`) and copies them into its own memory; right after a
+// renderer is made again the cache makes the same images again, in the same
+// order, with what it knew of them and the larger texture's pixels
+// (`Restore`). The storage is the core's (waterbox/driver/kept_images.cpp).
+#pragma once
+
+#include <cstddef>
+#include <cstring>
+
+#include "common/common_types.h"
+#include "video_core/texture_cache/image_info.h"
+
+namespace VideoCommon::ChimeraKept {
+
+// One image as the cache had it when the state was taken.
+struct Record {
+    ImageInfo info;
+    u64 gpu_addr;
+    u64 cpu_addr;
+    u64 channel;
+    // a digest of the image's bytes in the console's memory
+    u64 guest_hash;
+    // the cache's record of changes to the larger texture: the GPU drew into
+    // it (modification tick), or it was made from the smaller one again
+    u64 modification_tick;
+    u64 scaled_writes;
+    u64 scale_tick;
+    u32 scale_rating;
+    // upscaled: the larger texture is the image
+    u32 rescaled;
+    // drawn into since it was last written to the console's memory
+    u32 gpu_modified;
+    // had views (the screen is shown only from an image that has one)
+    u32 had_views;
+};
+
+// One image found by Keep: its record, and how to read its larger texture.
+struct Found {
+    Record record;
+    // the larger texture's size in bytes (every level and layer, rows tightly
+    // packed); 0 when it is not upscaled or cannot be read (multisampled,
+    // three-dimensional)
+    u64 bytes;
+    void* image;
+    // reads rows [y, y + rows) of a level and layer of the larger texture
+    void (*read)(void* image, u32 level, u32 layer, u32 y, u32 rows, u8* out, size_t out_bytes);
+    // a level's size in the larger texture, and the bytes of one pixel
+    u32 (*width)(void* image, u32 level);
+    u32 (*height)(void* image, u32 level);
+    u32 bytes_per_pixel;
+    u32 reserved;
+};
+
+struct Hooks {
+    // Keep fills `found` (room for `most`) and hands them over in one call,
+    // with the cache's two counters
+    Found* found = nullptr;
+    size_t most = 0;
+    void (*keep)(const Found* found, size_t count, size_t left_out, u64 frame_tick,
+                 u64 modification_tick) = nullptr;
+    // After a renderer is made again: whether the last state kept images of
+    // an earlier renderer, how many, and the cache's counters then; and each
+    // of them in the order they were kept, with its larger texture's pixels
+    // (null when none were kept)
+    bool (*kept)(size_t* count, u64* frame_tick, u64* modification_tick) = nullptr;
+    const Record* (*record)(size_t i, const u8** pixels, u64* bytes) = nullptr;
+    // a scratch buffer for reading the console's memory (no allocation while
+    // a state is taken)
+    u8* scratch = nullptr;
+    size_t scratch_bytes = 0;
+};
+
+inline Hooks hooks;
+
+// a digest of `n` bytes, continued from `h` (0 to start; every piece but the
+// last a multiple of 8 bytes)
+inline u64 Digest(u64 h, const u8* p, size_t n) {
+    size_t i = 0;
+    for (; i + 8 <= n; i += 8) {
+        u64 w;
+        std::memcpy(&w, p + i, 8);
+        h = (h ^ w) * 0x9E3779B97F4A7C15ULL;
+        h ^= h >> 29;
+    }
+    for (; i < n; i++) {
+        h = (h ^ p[i]) * 0x100000001B3ULL;
+    }
+    return h;
+}
+
+} // namespace VideoCommon::ChimeraKept
