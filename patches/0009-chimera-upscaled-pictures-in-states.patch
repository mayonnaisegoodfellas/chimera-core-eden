+    glGetTextureSubImage(upscaled_backup.handle, static_cast<GLint>(level), 0, static_cast<GLint>(y),
+                         static_cast<GLint>(layer), static_cast<GLsizei>(ChimeraScaledWidth(level)),
+                         static_cast<GLsizei>(rows), 1, gl_format, gl_type,
