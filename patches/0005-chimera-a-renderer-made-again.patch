 void OGLSync::Release() {
     if (handle == 0)
         return;
+#ifdef CHIMERA
+    // Chimera: a sync object is a pointer into the driver's memory. One that
+    // came back with a savestate belongs to a context that is gone, and
+    // handing it to the driver is a wild pointer: it is forgotten.
+    if (g_chimera_forget_syncs) {
+        handle = 0;
+        return;
+    }
+#endif
 
     // Don't profile here, this one is expected to happen ingame.
     glDeleteSync(handle);
