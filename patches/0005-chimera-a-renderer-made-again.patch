 void HostMemory::ClearBackingRegion(size_t physical_offset, size_t length, u32 fill_value) {
+#ifdef CHIMERA
+    // Chimera: a page that already holds the value is not written again.
+    // Zeros over zeros change nothing the machine can see, but the sandbox
+    // counts a written page as changed: the game's heap, cleared when it is
+    // handed out, was 3.2 GiB of zeros in every savestate.
+    {
+        u8* const base = backing_base + physical_offset;
+        const u8 fill = static_cast<u8>(fill_value);
+        for (size_t at = 0; at < length;) {
+            const size_t n = (std::min)(size_t{0x1000} - ((physical_offset + at) & 0xfff), length - at);
+            u8* const p = base + at;
+            if (p[0] != fill || std::memcmp(p, p + 1, n - 1) != 0) {
+                std::memset(p, fill, n);
+            }
+            at += n;
+        }
+        return;
+    }
+#endif
     std::memset(backing_base + physical_offset, fill_value, length);
 }
 
