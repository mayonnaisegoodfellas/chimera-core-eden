+            }
+            channel->BindRasterizer(rasterizer);
+            rasterizer->InitializeChannel(*channel);
+            // the constant buffers a channel bound are kept by the rasterizer,
+            // per channel, and the guest binds them once
+            rasterizer->BindChannel(*channel);
+            channel->payload->maxwell_3d.ChimeraReplayBindings();
+        }
+        if (bound_channel >= 0 && current_channel != nullptr) {
+            rasterizer->BindChannel(*current_channel);
+        }
