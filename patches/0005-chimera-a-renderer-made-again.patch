+#ifdef CHIMERA
+template <typename Traits>
+void DeviceMemoryManager<Traits>::ChimeraResetCaching() {
+    const auto MarkRegionCaching = &DeviceMemoryManager<Traits>::DeviceMethods::MarkRegionCaching;
+    const size_t pages = num_counter_entries * subentries;
+    for (size_t page = 0; page < pages; page++) {
+        CounterAtomicType& count = cached_pages->at(page >> subentries_shift).Count(page);
+        if (count.load(std::memory_order::relaxed) == 0) {
+            continue;
+        }
+        count.store(0, std::memory_order::relaxed);
+        auto [asid, vaddress] = ExtractCPUBacking(page);
+        if ((vaddress >> Memory::YUZU_PAGEBITS) == 0) {
+            continue;
+        }
+        if (auto* memory = registered_processes[asid.id]; memory != nullptr) {
+            MarkRegionCaching(memory, vaddress & ~VAddr{Memory::YUZU_PAGESIZE - 1},
+                              Memory::YUZU_PAGESIZE, false);
+        }
+    }
+}
+#endif
