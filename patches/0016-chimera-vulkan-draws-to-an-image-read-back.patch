+#ifdef CHIMERA
 StagingBufferRef StagingBufferPool::Request(size_t size, MemoryUsage usage, bool deferred) {
+    StagingBufferRef ref = ChimeraRequest(size, usage, deferred);
+    if (ref.mapped_span.empty() || usage == MemoryUsage::DeviceLocal) {
+        return ref;
+    }
+    ChimeraRange range{
+        .allocator = nullptr,
+        .allocation = nullptr,
+        .offset = ref.offset,
+        .size = static_cast<VkDeviceSize>(size),
+        .tick = scheduler.CurrentTick(),
+        .index = ref.index,
+        .deferred = deferred,
+    };
+    if (ref.buffer == *stream_buffer) {
+        range.allocator = stream_buffer.ChimeraAllocator();
+        range.allocation = stream_buffer.ChimeraAllocation();
+    } else {
+        for (const StagingBuffer& entry : GetCache(ref.usage)[ref.log2_level].entries) {
+            if (entry.index == ref.index) {
+                range.allocator = entry.buffer.ChimeraAllocator();
+                range.allocation = entry.buffer.ChimeraAllocation();
+                break;
+            }
+        }
+    }
+    if (!range.allocation) {
+        return ref;
+    }
+    std::scoped_lock lock{chimera_mutex};
+    (usage == MemoryUsage::Download ? chimera_downloads : chimera_uploads).push_back(range);
+    return ref;
+}
+
+void StagingBufferPool::ChimeraFlushUploads() {
+    std::scoped_lock lock{chimera_mutex};
+    for (const ChimeraRange& range : chimera_uploads) {
+        vmaFlushAllocation(range.allocator, range.allocation, range.offset, range.size);
+    }
+    chimera_uploads.clear();
+}
+
+void StagingBufferPool::ChimeraInvalidateDownloads(u64 tick) {
+    std::scoped_lock lock{chimera_mutex};
+    std::erase_if(chimera_downloads, [tick](const ChimeraRange& range) {
+        if (range.tick > tick) {
+            return false;
+        }
+        vmaInvalidateAllocation(range.allocator, range.allocation, range.offset, range.size);
+        // a deferred one is read when it is freed, at a wait of its own
+        return !range.deferred;
+    });
+}
