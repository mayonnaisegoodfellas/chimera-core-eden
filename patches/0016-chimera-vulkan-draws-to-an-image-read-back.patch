+    constexpr VkFormat format = VK_FORMAT_B8G8R8A8_UNORM;
+    const VkDeviceSize bytes = VkDeviceSize{layout.width} * layout.height * 4;
+    if (bytes != chimera_download_size) {
+        scheduler.Finish();
+        chimera_download = CreateWrappedBuffer(memory_allocator, bytes, MemoryUsage::Download);
+        chimera_download_size = bytes;
+    }
