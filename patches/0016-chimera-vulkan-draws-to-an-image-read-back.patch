+        DownloadColorImage(cmdbuf, image, buffer, extent);
+    });
+    scheduler.Finish();
+    // the memory is the host's, read in only when asked (it is never
+    // coherent through the bridge)
+    chimera_download.Invalidate();
+    if (g_chimera_picture) {
+        g_chimera_picture(chimera_download.Mapped().data(), layout.width, layout.height);
+    }
