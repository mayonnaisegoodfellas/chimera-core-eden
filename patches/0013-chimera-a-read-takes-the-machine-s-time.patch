+++ b/src/core/hle/service/filesystem/fsp/fs_i_storage.h
@@ -25,6 +25,10 @@
     static constexpr s64 ReadBytesPerSecond = 40'000'000;
     static constexpr s64 MaxChargedReadSize = 64 * 1024;
     std::chrono::steady_clock::time_point next_read_tick{};
+#ifdef CHIMERA
+    // (the machine's clock, in nanoseconds: see Read)
+    s64 chimera_next_read_ns{};
+#endif
 
     Result Read(
         OutBuffer<BufferAttr_HipcMapAlias | BufferAttr_HipcMapTransferAllowsNonSecure> out_bytes,
