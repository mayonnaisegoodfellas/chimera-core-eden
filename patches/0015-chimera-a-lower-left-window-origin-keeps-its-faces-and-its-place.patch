+#ifdef CHIMERA
+// Chimera: with the window origin at the lower left, the viewports and the
+// scissors are placed from the bottom of the drawing area (see SyncViewport).
+// They then depend on the origin and on the area's height, and neither marks
+// them for update when it changes: all of them are placed again.
+void RasterizerOpenGL::ChimeraPlaceFromOrigin() {
+    auto& flags = maxwell3d->dirty.flags;
+    const auto& regs = maxwell3d->regs;
+    const bool lower_left = regs.window_origin.mode != Maxwell::WindowOrigin::Mode::UpperLeft;
+    const u32 height = lower_left ? static_cast<u32>(regs.surface_clip.height) : 0U;
+    if (lower_left == chimera_placed_lower_left && height == chimera_placed_height) {
+        return;
+    }
+    chimera_placed_lower_left = lower_left;
+    chimera_placed_height = height;
+    flags[Dirty::Viewports] = true;
+    flags[Dirty::ViewportTransform] = true;
+    flags[Dirty::Scissors] = true;
+    for (size_t index = 0; index < Maxwell::NumViewports; ++index) {
+        flags[Dirty::Scissor0 + index] = true;
+    }
+}
+#endif
