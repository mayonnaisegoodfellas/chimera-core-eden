+#ifdef CHIMERA
+void RasterizerOpenGL::ChimeraDrawQuads(bool is_indexed, GLsizei num_instances,
+                                        GLuint base_instance) {
+    const auto& draw_state = maxwell3d->draw_manager.draw_state;
+    // the two triangles of a quad, as the Vulkan backend splits it
+    static constexpr std::array<u32, 6> SPLIT{0, 1, 2, 0, 2, 3};
+    auto& indices = chimera_quad_indices;
+    indices.clear();
+    GLint base_vertex = 0;
+    if (is_indexed) {
+        base_vertex = GLint(draw_state.base_index);
+        const u32 count = draw_state.index_buffer.count;
+        const u32 width = u32(draw_state.index_buffer.FormatSizeInBytes());
+        std::vector<u8> raw(size_t(count) * width);
+        if (!draw_state.inline_index_draw_indexes.empty()) {
+            std::memcpy(raw.data(), draw_state.inline_index_draw_indexes.data(),
+                        (std::min)(raw.size(), draw_state.inline_index_draw_indexes.size()));
+        } else {
+            gpu_memory->ReadBlockUnsafe(draw_state.index_buffer.StartAddress() +
+                                            u64(draw_state.index_buffer.first) * width,
+                                        raw.data(), raw.size());
+        }
+        const auto at = [&](u32 i) -> u32 {
+            u32 value = 0;
+            std::memcpy(&value, raw.data() + size_t(i) * width, width);
+            return value;
+        };
+        for (u32 quad = 0; quad + 3 < count; quad += 4) {
+            for (const u32 corner : SPLIT) {
+                indices.push_back(at(quad + corner));
+            }
+        }
+    } else {
+        base_vertex = GLint(draw_state.vertex_buffer.first);
+        const u32 count = draw_state.vertex_buffer.count;
+        for (u32 quad = 0; quad + 3 < count; quad += 4) {
+            for (const u32 corner : SPLIT) {
+                indices.push_back(quad + corner);
+            }
+        }
+    }
+    if (indices.empty()) {
+        return;
+    }
+    if (chimera_quad_buffer.handle == 0) {
+        chimera_quad_buffer.Create();
+    }
+    glNamedBufferData(chimera_quad_buffer.handle, GLsizeiptr(indices.size() * sizeof(u32)),
+                      indices.data(), GL_STREAM_DRAW);
+    // (the buffer cache binds its own before every indexed draw, the same way)
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, chimera_quad_buffer.handle);
+    glDrawElementsInstancedBaseVertexBaseInstance(GL_TRIANGLES, GLsizei(indices.size()),
+                                                  GL_UNSIGNED_INT, nullptr, num_instances,
+                                                  base_vertex, base_instance);
+}
+#endif
